@using ProjectN.Models
@model Blog

<!-- ================ Banner ================= -->
<section class="blog-banner-area" id="blog">
    <div class="container h-100">
        <div class="blog-banner">
            <div class="text-center">
                <h1>Blog Details</h1>

                <nav aria-label="breadcrumb" class="banner-breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="breadcrumb-item">
                            <a asp-controller="Blog" asp-action="Index">Blog</a>
                        </li>

                        <li class="breadcrumb-item active">
                            Details
                        </li>
                    </ol>
                </nav>

            </div>
        </div>
    </div>
</section>

<!--================ Blog Area =================-->

<section class="blog_area single-post-area py-80px section-margin--small">

    <div class="container">

        <div class="row">

            <div class="col-lg-8 posts-list">

                <div class="single-post">

                    <div class="feature-img mb-4">

                        <img class="img-fluid"
                             src="~/uploads/blogs/@Model.ImageUrl"
                             alt="@Model.Title">

                        </div>

                        <div class="blog_details">

                            <div class="mb-3 text-muted">

                                <i class="fa fa-user"></i>
                                @Model.Author

                                <span class="mx-3"></span>

                                <i class="fa fa-calendar"></i>
                                @Model.CreatedAt.ToString("dd MMM yyyy")

                            </div>

                            <h2 class="mb-3">

                                @Model.Title

                            </h2>

                            <p class="lead">

                                @Model.Description

                            </p>

                            <hr />

                            <div class="mt-4">

                                @Html.Raw(Model.Content)

                            </div>

                        </div>

                    </div>

                </div>
                <div class="col-lg-4">

                    <div class="blog_right_sidebar">

                        <!-- Search -->
                        <aside class="single_sidebar_widget search_widget">

                            <form asp-controller="Blog"
                                  asp-action="Index"
                                  method="get">

                                <div class="input-group">

                                    <input type="text"
                                           name="search"
                                           class="form-control"
                                           placeholder="Search Posts" />

                                    <span class="input-group-btn">

                                        <button class="btn btn-default"
                                                type="submit">

                                            <i class="lnr lnr-magnifier"></i>

                                        </button>

                                    </span>

                                </div>

                            </form>

                            <div class="br"></div>

                        </aside>

                        <!-- Popular Posts -->
                        <aside class="single_sidebar_widget popular_post_widget">

                            <h3 class="widget_title">
                                Popular Posts
                            </h3>

                            @foreach (var blog in ViewBag.PopularBlogs as List<Blog>)
                            {
                                <div class="media post_item">

                                    <img src="~/uploads/blogs/@blog.ImageUrl"
                                         style="width:80px;height:60px;object-fit:cover;"
                                         alt="@blog.Title">

                                        <div class="media-body">

                                            <a asp-controller="Blog"
                                                   asp-action="Details"
                                                   asp-route-id="@blog.Id">

                                                <h3>

                                                    @(blog.Title.Length > 25
                                                        ? blog.Title.Substring(0, 25) + "..."
                                                        : blog.Title)

                                                </h3>

                                            </a>

                                            <p>
                                                @blog.CreatedAt.ToString("dd MMM yyyy")
                                            </p>

                                        </div>

                                    </div>
                                }

                                <div class="br"></div>

                            </aside>

                            <!-- Newsletter -->
                            <aside class="single-sidebar-widget newsletter_widget">

                                <h4 class="widget_title">
                                    Newsletter
                                </h4>

                                <p>
                                    Subscribe to our newsletter and stay updated with our latest products and blog articles.
                                </p>

                                @if (TempData["Success"] != null)
                                {
                                    <div class="alert alert-success">
                                        @TempData["Success"]
                                    </div>
                                }

                                @if (TempData["Error"] != null)
                                {
                                    <div class="alert alert-danger">
                                        @TempData["Error"]
                                    </div>
                                }

                                <form asp-controller="Newsletter"
                                      asp-action="Subscribe"
                                      method="post">

                                    <input type="hidden"
                                           name="returnUrl"
                                           value="@Context.Request.Path" />

                                    <div class="form-group d-flex flex-row">

                                        <div class="input-group">

                                            <div class="input-group-prepend">

                                                <div class="input-group-text">

                                                    <i class="fa fa-envelope"></i>

                                                </div>

                                            </div>

                                            <input type="email"
                                                   name="Email"
                                                   class="form-control"
                                                   placeholder="Enter email address"
                                                   required />

                                        </div>

                                        <button type="submit"
                                                class="bbtns">

                                            Subscribe

                                        </button>

                                    </div>

                                </form>

                                <p class="text-bottom">
                                    You can unsubscribe at any time.
                                </p>

                            </aside>

                        </div>

                    </div>

                </div>

            </div>

        </section>