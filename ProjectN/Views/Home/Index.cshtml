@using ProjectN.Models
@using ProjectN.ViewModels.Home
@model HomeVM
<main class="site-main">
    
    <!--================ Hero banner start =================-->
    @if (Model.HeroBanner != null)
    {
        <section class="hero-banner">
            <div class="container">
                <div class="row no-gutters align-items-center pt-60px">
                    <div class="col-5 d-none d-sm-block">
                        <div class="hero-banner__img">
                            <img class="img-fluid"
                                 src="~/uploads/herobanners/@Model.HeroBanner.ImageUrl"
                                 alt="@Model.HeroBanner.Title">
                            </div>
                        </div>

                        <div class="col-sm-7 col-lg-6 offset-lg-1 pl-4 pl-md-5 pl-lg-0">
                            <div class="hero-banner__content">
                                <h4>@Model.HeroBanner.Subtitle</h4>
                                <h1>@Model.HeroBanner.Title</h1>
                                <p>@Model.HeroBanner.Description</p>

                                <a href="@Model.HeroBanner.ButtonUrl"
                                       class="button button-hero">
                                    @Model.HeroBanner.ButtonText
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }
    <!--================ Hero banner start =================-->
    <!--================ Hero Carousel start =================-->
        <section class="section-margin mt-0">
            <div class="owl-carousel owl-theme hero-carousel">

                @foreach (ProjectN.Models.Category category in Model.Categories)
                {
                    <div class="hero-carousel__slide">

                        <img src="~/uploads/categories/@category.ImageUrl"
                             alt="@category.Name"
                             class="img-fluid">

                            <a asp-controller="Category"
                                   asp-action="Details"
                                   asp-route-id="@category.Id"
                                   class="hero-carousel__slideOverlay">

                                <h3>@category.Name</h3>

                                <p>@category.Description</p>

                            </a>

                        </div>
                    }

                </div>
            </section>
    <!--================ Hero Carousel end =================-->
    <!-- ================ trending product section start ================= -->
    <section class="section-margin calc-60px">
        <div class="container">
            <div class="section-intro pb-60px">
                <p>Popular Item in the market</p>
                <h2>Trending <span class="section-intro__style">Product</span></h2>
            </div>
            <div class="row">
                
                                @foreach (Product product in Model.Products)
                    {  
                        
                            bool isWishlisted = product.Wishlists.Any(w => w.AppUserId == ViewBag.UserId);
                                              
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card text-center card-product">
                        <div class="card-product__img">
                            <img class="card-img" src="~/uploads/products/@product.ImageUrl" alt="">
                            <ul class="card-product__imgOverlay">
                                <li><button><a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id" class="ti-search"></a></button></li>
                                                        <li>
                                                            <button onclick="location.href='@Url.Action("AddToCart","Cart", new { id = product.Id })'">
                                                                <i class="ti-shopping-cart"></i>
                                                            </button>
                                                        </li>
                                                            <li>
                                                                <a asp-controller="Wishlist"
                                                                       asp-action="Toggle"
                                                                       asp-route-id="@product.Id">

                                                                    @if (isWishlisted)
                                                                    {
                                                                    <i class="fas fa-heart text-danger"></i>
                                                                    }
                                                                    else
                                                                    {
                                                                    <i class="far fa-heart"></i>
                                                                    }

                                                                </a>
                                                            </li>
                            </ul>
                        </div>
                        <div class="card-body">
                            <p>@product.Category.Name</p>
                            <h4 class="card-product__title"><a href="single-product.html">@product.Name</a></h4>
                            <p class="card-product__price">$@product.Price</p>
                        </div>
                    </div>
                </div>
               
                    }
                
            </div>
        </div>
    </section>
    <!-- ================ trending product section end ================= -->
    <!-- ================ offer section start ================= -->
                        <@{
                            string backgroundImage = Model.Campaign != null
                            ? $"/uploads/campaigns/{Model.Campaign.ImageUrl}"
                            : "/assets/img/home/parallax-bg.png";
                        }

                        <section class="offer"
                                 id="parallax-1"
                                 style="background-image:url('@backgroundImage')"
                                 data-anchor-target="#parallax-1"
                                 data-300-top="background-position: 20px 30px"
                                 data-top-bottom="background-position: 0 20px">

                            <div class="container">
                                <div class="row">
                                    <div class="col-xl-5">
                                        <div class="offer__content text-center">

                                            @if (Model.Campaign != null)
                                            {
                                                <h3>@Model.Campaign.Subtitle</h3>
                                                <h4>@Model.Campaign.Title</h4>
                                                <p>@Model.Campaign.Description</p>

                                                <a  class="button button--active mt-3 mt-xl-4"
                                                       href="@Model.Campaign.ButtonUrl">
                                                    @Model.Campaign.ButtonText
                                                </a>
                                            }

                                        </div>
                                    </div>
                                </div>
                            </div>

                        </section>
    <!-- ================ offer section end ================= -->
    <!-- ================ Best Selling item  carousel ================= -->
    <section class="section-margin calc-60px">
        <div class="container">
            <div class="section-intro pb-60px">
                <p>Popular Item in the market</p>
                <h2>Best <span class="section-intro__style">Sellers</span></h2>
            </div>
            <div class="owl-carousel owl-theme" id="bestSellerCarousel">
                @foreach(Product product in Model.BestSellers)
                {
                                        bool isWishlisted = product.Wishlists.Any(w => w.AppUserId == ViewBag.UserId);
                <div class="card text-center card-product">
                    <div class="card-product__img">
                        <img class="img-fluid" src="~/uploads/products/@product.ImageUrl" alt="">
                        <ul class="card-product__imgOverlay">
                            <li><button><a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id" class="ti-search"></a></button></li>
                            <li><button onclick="location.href='@Url.Action("AddToCart","Cart", new { id = product.Id })'">
                                                                <i class="ti-shopping-cart"></i>
                                                            </button></li>
                                                        <li>
                                                            <a asp-controller="Wishlist"
                                                                   asp-action="Toggle"
                                                                   asp-route-id="@product.Id">

                                                                @if (isWishlisted)
                                                                {
                                                                    <i class="fas fa-heart text-danger"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="far fa-heart"></i>
                                                                }

                                                            </a>
                                                        </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <p>@product.Category.Name</p>
                        <h4 class="card-product__title"><a href="single-product.html">@product.Name</a></h4>
                        <p class="card-product__price">$@product.Price</p>
                    </div>
                </div> 
                }

            </div>
        </div>
    </section>
    <!-- ================ Best Selling item  carousel end ================= -->
    <!-- ================ Blog section start ================= -->
    <section class="blog">
        <div class="container">
            <div class="section-intro pb-60px">
                <p>Popular Item in the market</p>
                <h2>Latest <span class="section-intro__style">News</span></h2>
            </div>

            <div class="row">
                                @foreach (var blog in Model.Blogs)
                                {
                                    <div class="col-md-6 col-lg-4 mb-4 mb-lg-0">
                                        <div class="card card-blog">

                                            <div class="card-blog__img">
                                                <img class="card-img rounded-0"
                                                     src="~/uploads/blogs/@blog.ImageUrl"
                                                     alt="@blog.Title">
                                                </div>

                                                <div class="card-body">

                                                    <ul class="card-blog__info">
                                                        <li>
                                                            <a href="#">By @blog.Author</a>
                                                        </li>
                                                        <li>
                                                            <a href="#">
                                                                @blog.CreatedAt.ToString("dd MMM yyyy")
                                                            </a>
                                                        </li>
                                                    </ul>

                                                    <h4 class="card-blog__title">
                                                        <a asp-controller="Blog"
                                                               asp-action="Details"
                                                               asp-route-id="@blog.Id">
                                                            @blog.Title
                                                        </a>
                                                    </h4>

                                                    <p>@blog.Description</p>

                                                    <a class="card-blog__link"
                                                           asp-controller="Blog"
                                                           asp-action="Details"
                                                           asp-route-id="@blog.Id">
                                                        Read More
                                                        <i class="ti-arrow-right"></i>
                                                    </a>

                                                </div>

                                            </div>
                                        </div>
                                    }             
            </div>
        </div>
    </section>
    <!-- ================ Blog section end ================= -->
    <!-- ================ Subscribe section start ================= -->
                        <section class="subscribe-position">
                            <div class="container">
                                <div class="subscribe text-center">
                                    <h3 class="subscribe__title">Subscribe to Our Newsletter</h3>

                                    <p>
                                        Subscribe to receive the latest product updates, exclusive offers,
                                        and our newest blog posts directly in your inbox.
                                    </p>
                                    @if (TempData["Success"] != null)
                                    {
                                        <div class="alert alert-success mb-3">
                                            @TempData["Success"]
                                        </div>
                                    }

                                    @if (TempData["Error"] != null)
                                    {
                                        <div class="alert alert-danger mb-3">
                                            @TempData["Error"]
                                        </div>
                                    }
                                    <div>
                                        <form asp-controller="Newsletter"
                                              asp-action="Subscribe"
                                              method="post"
                                              class="subscribe-form form-inline mt-5 pt-1">

                                            <div class="form-group ml-sm-auto">
                                                <input class="form-control mb-1"
                                                       type="email"
                                                       name="Email"
                                                       placeholder="Enter your email address"
                                                       required />
                                            </div>

                                            <button class="button button-subscribe mr-auto mb-1"
                                                    type="submit">
                                                Subscribe
                                            </button>

                                        </form>
                                    </div>
                                </div>
                            </div>
                        </section>
    <!-- ================ Subscribe section end ================= -->
</main>
