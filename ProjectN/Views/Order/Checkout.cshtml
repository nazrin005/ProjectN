@using ProjectN.Models
@model List<Cart>
<!--================Cart Area =================-->
<section class="cart_area">
    <div class="container">
        <div class="cart_inner">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Product</th>
                            <th scope="col">Price</th>
                            <th scope="col">Quantity</th>
                            <th scope="col">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Cart item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="media">
                                        <div class="d-flex">
                                            <img src="~/uploads/products/@item.Product.ImageUrl" alt="">
                                            </div>
                                            <div class="media-body">
                                                <p>@item.Product.Name</p>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <h5>$@item.Product.Price</h5>
                                    </td>

                                    <td>
                                        <h5>@item.Count</h5>
                                    </td>

                                    <td>
                                        <h5>$@(item.Product.Price * item.Count)</h5>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td></td>
                                <td></td>
                                <td>
                                    <h5>Total</h5>
                                </td>
                                <td>
                                    <h5>$@Model.Sum(x => x.Product.Price * x.Count)</h5>
                                </td>                              
                            </tr>
                        </tbody>
                    </table>
                    <div class="checkout_btn_inner d-flex justify-content-end">
                        <form asp-action="PlaceOrder" method="post">
                            <button type="submit" class="primary-btn">
                                Place Order
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>