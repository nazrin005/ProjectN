@using ProjectN.Areas.Admin.ViewModels.HeroBanners
@model UpdateHeroBannerVM
<div>
    <h2>Update HeroBanner</h2>
    <form asp-controller="HeroBanner" asp-action="Update" method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <div class="form-group">
            <label for="Title">Title</label>
            <input asp-for="Title" type="text" class="form-control" id="Title" placeholder="Enter title">
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="Subtitle">Subtitle</label>
                <input asp-for="Subtitle" type="text" class="form-control" id="Subtitle" placeholder="Enter subtitle">
                    <span asp-validation-for="Subtitle" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label for="Description">Description</label>
                    <input asp-for="Description" type="text" class="form-control" id="Description" placeholder="Enter description">
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-3">
                            <img src="~/uploads/heroBanners/@Model.ImageUrl"
                                 width="200"
                                 class="img-thumbnail" />
                        </div>
                    }
                    <div class="form-group">
                        <label for="ImageFile">Select new Image</label>
                        <input asp-for="ImageFile" type="file" class="form-control" id="ImageFile">
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="ButtonText"></label>
                            <input asp-for="ButtonText" class="form-control" placeholder="Enter button text" />
                            <span asp-validation-for="ButtonText" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="ButtonUrl"></label>
                            <input asp-for="ButtonUrl" class="form-control" placeholder="Enter button url" />
                            <span asp-validation-for="ButtonUrl" class="text-danger"></span>
                        </div>
                        <div class="form-check mt-3">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                        <button type="submit" class="btn btn-primary">Update</button>
                    </form>
                </div>
