@using ProjectN.Models
@model List<Category>
<a asp-controller="Category" asp-action="Create" class="btn btn-primary">Create Category</a>
<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Name</th>
            <th scope="col">Description</th>
            <th scope="col">Image</th>
            <th scope="col">Deleted Status</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            foreach (Category category in Model)
            {
                <tr>
                    <th scope="row">@category.Id</th>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td>
                        <img height="80px" width="80px" src="~/uploads/categories/@category.ImageUrl" />
                    </td>
                    <td>@category.IsDeleted</td>
                    <td>
                        @if (category.IsDeleted == true)
                        {
                            <form asp-controller="Category" asp-action="Restore" asp-route-id="@category.Id"><button type="submit" class="btn btn-success">Restore</button></form>
                        }
                        else
                        {
                            <form asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id"><button type="submit" class="btn btn-danger">Delete</button></form>
                        }
                    </td>
                    <td><a asp-controller="Category" asp-action="Update" asp-route-id="@category.Id" class="btn btn-warning">Update</a></td>
                </tr>
            }
        }
    </tbody>
</table>